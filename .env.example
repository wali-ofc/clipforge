# Copy this file to .env (project root) or backend/.env and adjust as needed.
# backend/.env takes precedence over the project-root .env.

APP_ENV=development
APP_NAME=ClipForge
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Paths are resolved relative to the backend/ directory unless absolute.
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/clipforge.db

# Upload limits. 5 GiB default.
MAX_UPLOAD_BYTES=5368709120
UPLOAD_CHUNK_BYTES=1048576
# JSON array. Accepted container extensions.
ALLOWED_VIDEO_EXTENSIONS=["mp4","mov","mkv"]

# Local frontend origins allowed by CORS.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Media tools. Use full paths if ffmpeg/ffprobe are not on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFPROBE_TIMEOUT_SECONDS=60

# Background worker
WORKER_AUTOSTART=true
WORKER_POLL_INTERVAL_SECONDS=1.0

# --- Phase 2: transcription ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
# Local model cache (gitignored). First run downloads the model here.
WHISPER_MODEL_DIR=./data/models
# Leave empty to auto-detect the spoken language.
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
AUDIO_EXTRACT_TIMEOUT_SECONDS=3600

# --- Phase 3: AI clip selection (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false

# Target clip length and wider hard limits, in seconds.
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=60
CLIP_HARD_MIN_SECONDS=15
CLIP_HARD_MAX_SECONDS=90
MAX_CLIPS=8

# Transcript chunking. Windows overlap so context spanning a boundary is
# visible to the model twice. Absolute source timestamps are preserved.
CLIP_WINDOW_SECONDS=180
CLIP_WINDOW_OVERLAP_SECONDS=30
CLIP_MAX_CANDIDATES_PER_CHUNK=4

# JSON object. Keys must be exactly these five; values are normalized to 1.
CLIP_SCORE_WEIGHTS={"hook":0.25,"clarity":0.25,"payoff":0.20,"emotion_or_interest":0.20,"conciseness":0.10}

# --- Later phases (not used yet) ---
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_CRF=23
OUTPUT_PRESET=veryfast

FACE_SAMPLE_FPS=2
