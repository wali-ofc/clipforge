# Copy this file to .env (project root) or backend/.env and adjust as needed.
# backend/.env takes precedence over the project-root .env.

APP_ENV=development
APP_NAME=ClipForge
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Paths are resolved relative to the backend/ directory unless absolute.
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/clipforge.db

# Upload limits. 5 GiB default.
MAX_UPLOAD_BYTES=5368709120
UPLOAD_CHUNK_BYTES=1048576
# JSON array. Accepted container extensions.
ALLOWED_VIDEO_EXTENSIONS=["mp4","mov","mkv"]

# Local frontend origins allowed by CORS.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Media tools. Use full paths if ffmpeg/ffprobe are not on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFPROBE_TIMEOUT_SECONDS=60

# Background worker
WORKER_AUTOSTART=true
WORKER_POLL_INTERVAL_SECONDS=1.0

# --- Later phases (not used yet) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=60
MAX_CLIPS=8

OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_CRF=23
OUTPUT_PRESET=veryfast

FACE_SAMPLE_FPS=2
